<Window x:Class="DSPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:ctrl="clr-namespace:DSPlayer.Controls"
        Title="DSPlayer"
        Icon="pack://application:,,,/Assets/dsplayer.ico"
        Width="1280"
        Height="720"
        MinWidth="480"
        MinHeight="300"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
      Resize: NOT whole-window chrome. Video periphery only (pointer poll + HT*).
      No visual frame around video. AR via WM_SIZING. Initial snap on file-loaded.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="フルスクリーン" Click="Menu_Fullscreen_Click"/>
            <MenuItem Header="一時停止 / 再開" Click="Menu_Pause_Click"/>
            <MenuItem x:Name="MenuReconnect" Header="再接続" IsEnabled="False" Click="Menu_Reconnect_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuAlwaysOnTop" Header="最前面に表示" IsCheckable="True" Click="Menu_AlwaysOnTop_Click"/>
            <MenuItem x:Name="MenuCommentVisible" Header="コメントを表示" IsCheckable="True" IsChecked="True" Click="Menu_CommentVisible_Click"/>
            <MenuItem Header="スレッドを選択..." Click="Menu_SelectThread_Click"/>
            <Separator/>
            <MenuItem Header="BBSブラウザを開く (PCRBrowser)" Click="Menu_OpenPcrBrowser_Click"/>
            <MenuItem Header="掲示板を既定ブラウザで開く" Click="Menu_OpenBoard_Click"/>
            <MenuItem Header="設定..." Click="Menu_Settings_Click"/>
            <MenuItem Header="ログフォルダを開く" Click="Menu_OpenLog_Click"/>
            <Separator/>
            <MenuItem Header="終了" Click="Menu_Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Comment list: Flat / Card layouts; colors from DynamicResource (set by CommentListTheme) -->
    <Window.Resources>
        <!-- Defaults (overwritten at runtime by ApplyCommentListTheme) -->
        <SolidColorBrush x:Key="CommentRowBorder" Color="#FFD0D0D0"/>
        <SolidColorBrush x:Key="CommentRowHover" Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="CommentRowNewBg" Color="#FFB8D4F0"/>
        <SolidColorBrush x:Key="CommentRowNewBorder" Color="#FF4A90D9"/>
        <SolidColorBrush x:Key="CommentCardBg" Color="#FFFFFCF8"/>
        <SolidColorBrush x:Key="CommentCardBorder" Color="#FFE4DFD6"/>
        <SolidColorBrush x:Key="CommentCardHoverBorder" Color="#FFD5CFC4"/>
        <SolidColorBrush x:Key="CommentCardNewBg" Color="#FFFFF6E8"/>
        <SolidColorBrush x:Key="CommentCardNewBorder" Color="#FFE8D4A8"/>
        <SolidColorBrush x:Key="CommentCardNewAccent" Color="#FFE0A84A"/>
        <SolidColorBrush x:Key="CommentCardAccentIdle" Color="#00000000"/>
        <SolidColorBrush x:Key="CommentBadgeBg" Color="#FFEEE8DF"/>
        <SolidColorBrush x:Key="CommentBadgeFg" Color="#FF6B6560"/>
        <CornerRadius x:Key="CommentCardCornerRadius">8</CornerRadius>
        <Thickness x:Key="CommentCardInnerPadding">10,8,10,10</Thickness>
        <Thickness x:Key="CommentItemPadding">6,8</Thickness>
        <Thickness x:Key="CommentItemMargin">0,0,0,2</Thickness>

        <!-- ===== Flat: PCR-like rows ===== -->
        <Style x:Key="CommentItemStyleFlat" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{DynamicResource CommentItemPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource CommentItemMargin}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CommentRowBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CommentRowHover}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CommentRowNewBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CommentRowNewBorder}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CommentItemTemplateFlat">
            <StackPanel>
                <ctrl:CommentHeaderBlock
                         Number="{Binding Number}"
                         NameText="{Binding NameText}"
                         DateId="{Binding DateId}"
                         ShowNumber="{Binding ShowNumber}"
                         ShowName="{Binding ShowName}"
                         ShowDate="{Binding ShowDate}"
                         IdCount="{Binding IdCount}"
                         Foreground="{DynamicResource HeaderForeground}"
                         FontFamily="{DynamicResource HeaderFontFamily}"
                         FontSize="{DynamicResource HeaderFontSize}"
                         FontWeight="{DynamicResource HeaderFontWeight}"
                         Margin="0,0,0,1"/>
                <ctrl:AnchorBodyBlock Body="{Binding BodyText, Mode=OneWay}"
                                      FontFamily="{DynamicResource BodyFontFamily}"
                                      FontSize="{DynamicResource BodyFontSize}"
                                      FontWeight="{DynamicResource BodyFontWeight}"
                                      Foreground="{DynamicResource BodyForeground}"
                                      Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Card: body-first hierarchy + res# badge ===== -->
        <Style x:Key="CommentItemStyleCard" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="{DynamicResource CommentItemPadding}"/>
            <Setter Property="Margin" Value="{DynamicResource CommentItemMargin}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource CommentCardBg}"
                                BorderBrush="{DynamicResource CommentCardBorder}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource CommentCardCornerRadius}"
                                Padding="{DynamicResource CommentCardInnerPadding}"
                                SnapsToDevicePixels="True">
                            <!-- Overlay rail only — must not push body text to the right -->
                            <Grid>
                                <ContentPresenter/>
                                <Border x:Name="Accent"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource CommentCardAccentIdle}"
                                        IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CommentCardHoverBorder}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CommentCardNewBg}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CommentCardNewBorder}"/>
                                <Setter TargetName="Accent" Property="Background" Value="{DynamicResource CommentCardNewAccent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="CommentItemTemplateCard">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{DynamicResource CommentBadgeBg}" CornerRadius="4"
                        Padding="7,2" Margin="0,0,8,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowResBadge}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Number}"
                               Foreground="#0055CC"
                               TextDecorations="Underline"
                               Cursor="Hand"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               ToolTip="クリックで >>この番号を引用"
                               MouseLeftButtonUp="ResBadge_MouseLeftButtonUp"/>
                </Border>
                <ctrl:CommentHeaderBlock Grid.Row="0" Grid.Column="1"
                         Number="{Binding Number}"
                         NameText="{Binding NameText}"
                         DateId="{Binding DateId}"
                         ShowNumber="False"
                         ShowName="{Binding ShowName}"
                         ShowDate="{Binding ShowDate}"
                         IdCount="{Binding IdCount}"
                         Foreground="{DynamicResource HeaderForeground}"
                         FontFamily="{DynamicResource HeaderFontFamily}"
                         FontSize="{DynamicResource HeaderFontSize}"
                         FontWeight="{DynamicResource HeaderFontWeight}"
                         VerticalAlignment="Center"/>
                <ctrl:AnchorBodyBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      Body="{Binding BodyText, Mode=OneWay}"
                                      FontFamily="{DynamicResource BodyFontFamily}"
                                      FontSize="{DynamicResource BodyFontSize}"
                                      FontWeight="{DynamicResource BodyFontWeight}"
                                      Foreground="{DynamicResource BodyForeground}"
                                      Margin="0,10,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- No outer chrome border (user preference: edge-to-edge) -->
    <Grid x:Name="RootLayoutGrid" Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <!-- Pixel-locked while write box is multi-line so video never resizes with Enter -->
                <RowDefinition x:Name="ContentRow" Height="*"/>
                <RowDefinition x:Name="WriteBarRow" Height="Auto"/>
                <RowDefinition x:Name="InfoBarRow" Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="MainSplitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VideoColumn" Width="*" MinWidth="240"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                    <ColumnDefinition x:Name="CommentColumn" Width="340" MinWidth="160"/>
                </Grid.ColumnDefinitions>

                <!--
                  Full-bleed video. Caption buttons are WinForms children of PlayerPanel
                  (VideoChromeOverlay) so they sit ON the video without taking layout space
                  and without a floating top-level window (no WPF-over-HwndHost airspace).
                -->
                <WindowsFormsHost x:Name="VideoHost" Grid.Column="0" Background="Black">
                    <wf:Panel x:Name="PlayerPanel" BackColor="Black" Dock="Fill" />
                </WindowsFormsHost>

                <GridSplitter x:Name="CommentSplitter"
                              Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#FF3A3A3A"
                              ShowsPreview="False"
                              DragCompleted="CommentSplitter_DragCompleted"/>

                <Border x:Name="CommentPanel"
                        Grid.Column="2"
                        Background="#FFF0F0F0"
                        BorderBrush="#FFD0D0D0"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <!-- Theme applied at runtime via ApplyCommentListTheme -->
                        <ListBox x:Name="CommentList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="4,0"
                                 Foreground="#FF000000"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 SelectionMode="Extended"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ScrollViewer.ScrollChanged="CommentScroll_ScrollChanged"
                                 SizeChanged="CommentList_SizeChanged"
                                 ItemContainerStyle="{StaticResource CommentItemStyleFlat}"
                                 ItemTemplate="{StaticResource CommentItemTemplateFlat}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <!-- Shown while reading history; click resumes live follow -->
                        <Button x:Name="NewPostsJumpButton"
                                Panel.ZIndex="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Margin="0,0,16,10"
                                Padding="12,5"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Focusable="False"
                                Visibility="Collapsed"
                                Click="NewPostsJumpButton_Click"
                                ToolTip="最新レスへ移動し、以降は自動で追従します"
                                Content="新着 ↓"/>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="WriteBar" Grid.Row="1"
                    Background="#FF1E1E1E"
                    BorderBrush="#FF2A2A2A"
                    BorderThickness="0,1,0,0"
                    Padding="8,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- フラットなスレタイ表示（旧デザイン）。クリックで一覧ポップアップ -->
                    <TextBlock x:Name="BoardTitleText"
                               Grid.Column="0"
                               Foreground="#FFAAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Text="掲示板"
                               Cursor="Hand"
                               ToolTip="クリックでスレッド選択（黒=書込可 / 灰=満了）"
                               MouseLeftButtonUp="BoardTitleText_MouseLeftButtonUp"/>

                    <Popup x:Name="ThreadPopup"
                           PlacementTarget="{Binding ElementName=BoardTitleText}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#FFFFFFFF"
                                BorderBrush="#FFCCCCCC"
                                BorderThickness="1"
                                MaxHeight="320"
                                MinWidth="280"
                                MaxWidth="420"
                                CornerRadius="2"
                                Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#FF000000"/>
                            </Border.Effect>
                            <ListBox x:Name="ThreadList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="320"
                                     MouseDoubleClick="ThreadList_MouseDoubleClick"
                                     KeyDown="ThreadList_KeyDown"
                                     PreviewMouseLeftButtonUp="ThreadList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFE8F0FF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFD0E0F0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!-- フォントは固定13。箱の高さは文字に合わせて余白を詰める。改行時だけ下に伸ばす -->
                    <TextBox x:Name="WriteBox"
                             Grid.Column="1"
                             Height="20"
                             MinHeight="20"
                             MaxHeight="160"
                             Padding="2,1"
                             BorderThickness="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Disabled"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Top"
                             Background="#FF2A2A2A"
                             Foreground="#FFE8E8E8"
                             BorderBrush="#FF444444"
                             CaretBrush="#FFE8E8E8"
                             FontSize="13"
                             ToolTip="本文（Enter=改行 / Shift+Enter=送信）"
                             PreviewKeyDown="WriteBox_PreviewKeyDown"
                             TextChanged="WriteBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="0"
                                                  Padding="0"
                                                  Focusable="False"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>

                    <Button x:Name="WriteButton"
                            Grid.Column="2"
                            Content="書込"
                            Width="56"
                            Height="28"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Click="WriteButton_Click"/>
                </Grid>
            </Border>

            <!-- Not a Popup: Popup+virtualized ListBox hangs WPF. Window overlay only. -->
            <Border x:Name="IdRefOverlay"
                    Grid.Row="0" Grid.RowSpan="3"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#FFFFFFF8"
                    BorderBrush="#FFCCCCCC"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    MinWidth="200"
                    MaxWidth="340"
                    Panel.ZIndex="20"
                    IsHitTestVisible="True"
                    MouseEnter="IdRefOverlay_MouseEnter"
                    MouseLeave="IdRefOverlay_MouseLeave">
                <StackPanel>
                    <TextBlock x:Name="IdRefTitle"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FF333333"
                               Margin="0,0,0,6"
                               Text="ID"/>
                    <StackPanel x:Name="IdRefRows"/>
                </StackPanel>
            </Border>

            <Border x:Name="InfoBar" Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    Padding="8,4"
                    MinHeight="28">
                <!-- Dock=Right is outermost first: Volume, stats, momentum, then status fills left -->
                <DockPanel LastChildFill="True">
                    <StackPanel x:Name="VolumePanel"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                ToolTip="クリックでミュート切替"
                                PreviewMouseLeftButtonDown="VolumePanel_PreviewMouseLeftButtonDown">
                        <TextBlock x:Name="VolumeLabel"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="音量"/>
                        <TextBlock x:Name="VolumeText"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   FontSize="11"
                                   FontFamily="Consolas, Cascadia Mono, Yu Gothic"
                                   Width="22"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Text="0"/>
                    </StackPanel>
                    <TextBlock x:Name="RightStatsText"
                               DockPanel.Dock="Right"
                               Foreground="#FFCCCCCC"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text=""/>
                    <!-- Left of resolution. Heat (default) or Simple — switch in settings. -->
                    <StackPanel x:Name="MomentumPanel"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                        <StackPanel x:Name="MomentumSimple"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="MomentumText"
                                       Foreground="{StaticResource ForegroundBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Text="勢い 0　過疎"/>
                            <Border x:Name="MomentumBarTrack"
                                    Width="64"
                                    Height="3"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="#33888888"
                                    SnapsToDevicePixels="True">
                                <Border x:Name="MomentumBarFill"
                                        HorizontalAlignment="Left"
                                        Width="0"
                                        Height="3"
                                        Background="#FF888888"
                                        SnapsToDevicePixels="True"/>
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="MomentumHeat"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    ToolTip="直近5分のレスの勢い"
                                    Visibility="Visible">
                            <TextBlock x:Name="MomentumHeatPrefix"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"
                                       Text="勢い(0)"/>
                            <TextBlock x:Name="MomentumHeatFilled"
                                       FontSize="13"
                                       FontFamily="Yu Gothic UI, Segoe UI Symbol, Meiryo UI"
                                       VerticalAlignment="Center"
                                       Text=""/>
                            <TextBlock x:Name="MomentumHeatEmpty"
                                       FontSize="13"
                                       FontFamily="Yu Gothic UI, Segoe UI Symbol, Meiryo UI"
                                       VerticalAlignment="Center"
                                       Opacity="0.45"
                                       Text="▱▱▱▱▱"/>
                            <TextBlock x:Name="MomentumHeatMood"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Text="過疎"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="準備中…"/>
                </DockPanel>
            </Border>

    </Grid>
</Window>
