<Window x:Class="DSPlayer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定 - DSPlayer"
        Icon="pack://application:,,,/Assets/dsplayer.ico"
        Width="540"
        Height="700"
        MinWidth="480"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="#FF1E1E1E"
        FontSize="13"
        FontFamily="Meiryo UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Background" Value="#FF343434"/>
            <Setter Property="Foreground" Value="#FFF2F2F2"/>
            <Setter Property="BorderBrush" Value="#FF5A5A5A"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF292929"/>
            <Setter Property="Foreground" Value="#FFF2F2F2"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF575757"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF6EC6FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,10"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="20,16,20,18">
        <Border DockPanel.Dock="Top" BorderBrush="#FF414141" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DSPlayer 設定" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="表示・操作・掲示板連携をまとめて調整できます" Foreground="#FF999999" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" BorderBrush="#FF414141" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="キャンセル" Width="104" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="保存" Width="104" IsDefault="True" Click="Ok_Click" Background="#FF1779BA" BorderBrush="#FF3095D4"/>
        </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="ウィンドウ" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkSaveWindowPlacement" Content="ウィンドウの位置とサイズを保存する"
                          Foreground="#FFE8E8E8" Margin="0,0,0,6"/>
                <CheckBox x:Name="ChkSaveVolume" Content="音量を保存する"
                          Foreground="#FFE8E8E8" Margin="0,0,0,12"
                          ToolTip="次回起動時に前回終了時の音量を復元します"/>
                <CheckBox x:Name="ChkWindowSnap" Content="ウィンドウの吸着を有効にする"
                          Foreground="#FFE8E8E8" Margin="0,0,0,6"/>
                <Grid Margin="0,2,0,8" IsEnabled="{Binding IsChecked, ElementName=ChkWindowSnap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="吸着先" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SnapTargetBox" Grid.Column="1" Height="28" Width="260" HorizontalAlignment="Left" Margin="0,0,0,6">
                        <ComboBoxItem Content="画面端だけ"/>
                        <ComboBoxItem Content="画面端と他のウィンドウ"/>
                    </ComboBox>
                    <TextBlock Text="吸着の強さ" Grid.Row="1" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="SnapStrengthBox" Grid.Row="1" Grid.Column="1" Height="28" Width="260" HorizontalAlignment="Left">
                        <ComboBoxItem Content="弱め"/>
                        <ComboBoxItem Content="標準"/>
                        <ComboBoxItem Content="強め"/>
                    </ComboBox>
                </Grid>
                <TextBlock Text="移動中に端へ近づけると吸着します。Shiftキーで一時解除。"
                           Foreground="#FFAAAAAA" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Separator Background="#FF414141" Margin="0,0,0,8"/>
                <TextBlock Text="コメント表示" Style="{StaticResource SectionTitle}"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="UI テーマ" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="UiThemeBox" Grid.Column="1" Height="28" Width="260" HorizontalAlignment="Left"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                              ToolTip="書込欄・ステータス・クロームの色。コメント欄とは独立して選べます"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="コメント見た目" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CommentThemeBox" Grid.Column="1" Height="28" Width="260" HorizontalAlignment="Left"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                              ToolTip="平面 / カード / 暗色など。UI テーマとは独立して選べます"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="勢いの見た目" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MomentumStyleBox" Grid.Column="1" Height="28" Width="260" HorizontalAlignment="Left"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                              ToolTip="ヒート＝勢い ▰▰▰▱▱。シンプル＝以前の「勢い 58　普通」"/>
                </Grid>

                <!-- A: レス情報 -->
                <TextBlock Text="レス情報（番号・名前・日時）" Foreground="#FFCCCCCC" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkShowNumber" Content="レス番号" Foreground="#FFE8E8E8" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkShowName" Content="名前" Foreground="#FFE8E8E8" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkShowDate" Content="日時" Foreground="#FFE8E8E8"/>
                </StackPanel>
                <Grid Margin="0,0,0,6" Width="390" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="フォント" Foreground="#FF888888" VerticalAlignment="Center"/>
                    <ComboBox x:Name="HeaderFontFamilyBox" Grid.Column="1" Height="28" Margin="0,0,8,0"
                              IsEditable="True"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"/>
                    <TextBlock Grid.Column="2" Text="サイズ" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="HeaderFontSizeBox" Grid.Column="3" Height="28"
                             Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                             CaretBrush="#FF000000" VerticalContentAlignment="Center"
                             ToolTip="8〜36"/>
                </Grid>
                <Grid Margin="0,0,0,8" Width="390" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="太さ" Foreground="#FF888888" VerticalAlignment="Center"/>
                    <ComboBox x:Name="HeaderWeightBox" Grid.Column="1" Height="28" Margin="0,0,8,0"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"/>
                    <TextBlock Grid.Column="2" Text="色" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="HeaderColorBox" Grid.Column="3" Height="28" IsEditable="True"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                              ToolTip="#RRGGBB"/>
                </Grid>
                <TextBlock x:Name="HeaderPreview"
                           Text="123 ：名前：2026/01/01 12:00:00"
                           Foreground="#FF888888" Background="#FFF0F0F0" Padding="6,4" Margin="0,0,0,16"
                           TextWrapping="Wrap" Width="390" HorizontalAlignment="Left"/>

                <!-- B: 本文 -->
                <TextBlock Text="本文" Foreground="#FFCCCCCC" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6" Width="390" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="フォント" Foreground="#FF888888" VerticalAlignment="Center"/>
                    <ComboBox x:Name="BodyFontFamilyBox" Grid.Column="1" Height="28" Margin="0,0,8,0"
                              IsEditable="True"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"/>
                    <TextBlock Grid.Column="2" Text="サイズ" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="BodyFontSizeBox" Grid.Column="3" Height="28"
                             Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                             CaretBrush="#FF000000" VerticalContentAlignment="Center"
                             ToolTip="8〜36"/>
                </Grid>
                <Grid Margin="0,0,0,8" Width="390" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="太さ" Foreground="#FF888888" VerticalAlignment="Center"/>
                    <ComboBox x:Name="BodyWeightBox" Grid.Column="1" Height="28" Margin="0,0,8,0"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"/>
                    <TextBlock Grid.Column="2" Text="色" Foreground="#FF888888" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="BodyColorBox" Grid.Column="3" Height="28" IsEditable="True"
                              Background="#FFFFFFFF" Foreground="#FF000000" BorderBrush="#FF888888"
                              ToolTip="#RRGGBB"/>
                </Grid>
                <TextBlock x:Name="BodyPreview"
                           Text="本文あいうえお ABC 123"
                           Foreground="#FF111111"
                           Background="#FFF0F0F0" Padding="6,4" Margin="0,0,0,16"
                           TextWrapping="Wrap" Width="390" HorizontalAlignment="Left"/>

                <Separator Background="#FF414141" Margin="0,0,0,8"/>
                <TextBlock Text="掲示板・外部ブラウザ" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="BBSブラウザ" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBox x:Name="PcrBrowserPathBox" Grid.Column="1" Height="32" VerticalContentAlignment="Center"
                             ToolTip="右クリックメニューの「BBSブラウザを開く」で使用する実行ファイル"/>
                    <Button Grid.Column="2" Content="参照..." Margin="8,0,0,0" Click="BrowsePcrBrowser_Click"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="更新間隔(秒)" Foreground="#FFAAAAAA" VerticalAlignment="Center"/>
                    <TextBox x:Name="IntervalBox" Grid.Column="1" Height="28" MaxWidth="80" HorizontalAlignment="Left"
                             Background="#FF2A2A2A" Foreground="#FFE8E8E8" BorderBrush="#FF555555"
                             CaretBrush="White" VerticalContentAlignment="Center"
                             ToolTip="5〜120秒。掲示板の負荷を抑える推奨値は7秒です"/>
                </Grid>
                <TextBlock Text="5秒以上（推奨7秒）" Foreground="#FF888888" Margin="110,-6,0,8"/>
                <CheckBox x:Name="ChkMessageNormalize" Content="本文を整形（空行・ｗｗｗ 圧縮）"
                          Foreground="#FFE8E8E8" Margin="0,3"/>
                <CheckBox x:Name="ChkEmbedImages" Content="画像URLをコメント欄に表示（jpg / png / gif）"
                          Foreground="#FFE8E8E8" Margin="0,8,0,3"
                          ToolTip="拡張子が画像のURLだけ取得。同時2件・1.5MBまで。重いときはオフ"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
