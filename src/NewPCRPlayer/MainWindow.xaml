<Window x:Class="NewPCRPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="NewPCRPlayer"
        Width="1280"
        Height="720"
        MinWidth="480"
        MinHeight="300"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
      Resize: NOT whole-window chrome. Video periphery only (pointer poll + HT*).
      No visual frame around video. AR via WM_SIZING. Initial snap on file-loaded.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="フルスクリーン" Click="Menu_Fullscreen_Click"/>
            <MenuItem Header="一時停止 / 再開" Click="Menu_Pause_Click"/>
            <Separator/>
            <MenuItem x:Name="MenuCommentVisible" Header="コメントを表示" IsCheckable="True" IsChecked="True" Click="Menu_CommentVisible_Click"/>
            <MenuItem Header="コメントを最下部へ" Click="Menu_ScrollBottom_Click"/>
            <MenuItem Header="選択をコピー" Click="Menu_CopyComment_Click" InputGestureText="Ctrl+C"/>
            <MenuItem Header="スレッドを選択..." Click="Menu_SelectThread_Click"/>
            <Separator/>
            <MenuItem Header="BBSブラウザを開く (PCRBrowser)" Click="Menu_OpenPcrBrowser_Click"/>
            <MenuItem Header="掲示板を既定ブラウザで開く" Click="Menu_OpenBoard_Click"/>
            <MenuItem Header="設定..." Click="Menu_Settings_Click"/>
            <MenuItem Header="ログフォルダを開く" Click="Menu_OpenLog_Click"/>
            <Separator/>
            <MenuItem Header="終了" Click="Menu_Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- No outer chrome border (user preference: edge-to-edge) -->
    <Grid Background="{StaticResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <!-- Pixel-locked while write box is multi-line so video never resizes with Enter -->
                <RowDefinition x:Name="ContentRow" Height="*"/>
                <RowDefinition x:Name="WriteBarRow" Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="MainSplitGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="VideoColumn" Width="*" MinWidth="240"/>
                    <ColumnDefinition x:Name="SplitterColumn" Width="4"/>
                    <ColumnDefinition x:Name="CommentColumn" Width="340" MinWidth="160"/>
                </Grid.ColumnDefinitions>

                <!--
                  Full-bleed video. Caption buttons are WinForms children of PlayerPanel
                  (VideoChromeOverlay) so they sit ON the video without taking layout space
                  and without a floating top-level window (no WPF-over-HwndHost airspace).
                -->
                <WindowsFormsHost x:Name="VideoHost" Grid.Column="0" Background="Black">
                    <wf:Panel x:Name="PlayerPanel" BackColor="Black" Dock="Fill" />
                </WindowsFormsHost>

                <GridSplitter x:Name="CommentSplitter"
                              Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#FF3A3A3A"
                              ShowsPreview="False"
                              DragCompleted="CommentSplitter_DragCompleted"/>

                <Border x:Name="CommentPanel"
                        Grid.Column="2"
                        Background="#FFF0F0F0"
                        BorderBrush="#FFD0D0D0"
                        BorderThickness="1,0,0,0">
                    <!--
                      Virtualized list. Latest N posts only (MaxDisplayedComments).
                      Light skin: bg #f0f0f0, text black (PCRPlayer default-ish).
                    -->
                    <ListBox x:Name="CommentList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="4,0"
                             Foreground="#FF000000"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.ScrollChanged="CommentScroll_ScrollChanged"
                             SizeChanged="CommentList_SizeChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="6,8"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="#FFD0D0D0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFE8E8E8"/>
                                                </Trigger>
                                                <!-- 新着: 青系 + 左ライン（最後に評価してホバーより優先） -->
                                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FFB8D4F0"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A90D9"/>
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="3,0,0,1"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Read-only TextBox: selectable/copyable (TextBlock cannot select) -->
                                    <TextBox Text="{Binding DisplayHeader, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#FF000000"
                                             FontFamily="{DynamicResource HeaderFontFamily}"
                                             FontSize="{DynamicResource HeaderFontSize}"
                                             TextWrapping="Wrap"
                                             IsReadOnlyCaretVisible="True"
                                             Cursor="IBeam"
                                             Padding="0"
                                             Focusable="True"/>
                                    <TextBox Text="{Binding BodyText, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="#FF000000"
                                             FontFamily="{DynamicResource BodyFontFamily}"
                                             FontSize="{DynamicResource BodyFontSize}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             IsReadOnlyCaretVisible="True"
                                             Cursor="IBeam"
                                             Margin="0,4,0,0"
                                             Padding="0"
                                             Focusable="True"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border x:Name="WriteBar" Grid.Row="1"
                    Background="#FF1E1E1E"
                    BorderBrush="#FF2A2A2A"
                    BorderThickness="0,1,0,0"
                    Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- フラットなスレタイ表示（旧デザイン）。クリックで一覧ポップアップ -->
                    <TextBlock x:Name="BoardTitleText"
                               Grid.Column="0"
                               Foreground="#FFAAAAAA"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Text="掲示板"
                               Cursor="Hand"
                               ToolTip="クリックでスレッド選択（黒=書込可 / 灰=満了）"
                               MouseLeftButtonUp="BoardTitleText_MouseLeftButtonUp"/>

                    <Popup x:Name="ThreadPopup"
                           PlacementTarget="{Binding ElementName=BoardTitleText}"
                           Placement="Top"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#FFFFFFFF"
                                BorderBrush="#FFCCCCCC"
                                BorderThickness="1"
                                MaxHeight="320"
                                MinWidth="280"
                                MaxWidth="420"
                                CornerRadius="2"
                                Padding="0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#FF000000"/>
                            </Border.Effect>
                            <ListBox x:Name="ThreadList"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MaxHeight="320"
                                     MouseDoubleClick="ThreadList_MouseDoubleClick"
                                     KeyDown="ThreadList_KeyDown"
                                     PreviewMouseLeftButtonUp="ThreadList_PreviewMouseLeftButtonUp">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFE8F0FF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#FFD0E0F0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding LabelBrush}"
                                                   FontWeight="{Binding LabelWeight}"
                                                   TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>

                    <!-- 1行=28px固定。改行(\n)があるときだけ下方向に伸ばす（変更しない） -->
                    <TextBox x:Name="WriteBox"
                             Grid.Column="1"
                             Height="28"
                             MinHeight="28"
                             MaxHeight="120"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalContentAlignment="Center"
                             Background="#FF2A2A2A"
                             Foreground="#FFE8E8E8"
                             BorderBrush="#FF444444"
                             CaretBrush="#FFE8E8E8"
                             FontSize="13"
                             ToolTip="本文（Enter=改行 / Shift+Enter=送信）"
                             PreviewKeyDown="WriteBox_PreviewKeyDown"
                             TextChanged="WriteBox_TextChanged"/>

                    <Button x:Name="WriteButton"
                            Grid.Column="2"
                            Content="書込"
                            Width="56"
                            Height="28"
                            Margin="8,0,0,0"
                            VerticalAlignment="Top"
                            Click="WriteButton_Click"/>
                </Grid>
            </Border>

            <Border x:Name="InfoBar" Grid.Row="2"
                    Background="{StaticResource StatusBarBrush}"
                    Padding="8,4"
                    MinHeight="28">
                <!-- Dock=Right is outermost first: Volume is far right, then stats, then status fills left -->
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="VolumeText"
                               DockPanel.Dock="Right"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text="音量 0"/>
                    <TextBlock x:Name="RightStatsText"
                               DockPanel.Dock="Right"
                               Foreground="#FFCCCCCC"
                               FontSize="11"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Text=""/>
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource ForegroundBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Text="準備中…"/>
                </DockPanel>
            </Border>
    </Grid>
</Window>
