<Application x:Class="NewPCRPlayer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FF1A1A1A"/>
        <SolidColorBrush x:Key="StatusBarBrush" Color="#FF252525"/>
        <SolidColorBrush x:Key="ForegroundBrush" Color="#FFE8E8E8"/>
    </Application.Resources>
</Application>
